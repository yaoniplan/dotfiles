# Z-Library (at least one of the following)
ZLIB_EMAIL=
ZLIB_PASSWORD=
# Multiple accounts (comma-separated email:password)
# ZLIB_ACCOUNTS=a@example.com:pass1,b@example.com:pass2
# ZLIB_ACCOUNTS_FILE=/path/to/accounts.txt
# ZLIB_DOMAIN=https://z-lib.gd

# Anna's Archive
# ANNAS_BASE_URL=https://annas-archive.li
# ANNAS_SECRET_KEY=

# Optional
# PUB_CACHE=/tmp/pub-epub-cache

# Library Genesis
# LIBGEN_BASE_URL=https://libgen.li

# OPDS catalogs
# OPDS_SOURCES=gutenberg,standardebooks
# OPDS_SEARCH_URL=https://example.org/search.opds?q=%s
